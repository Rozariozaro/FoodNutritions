{
    "openapi": "3.1.0",
    "info": {
        "title": "FastAPI",
        "version": "0.1.0"
    },
    "paths": {
        "/search": {
            "get": {
                "summary": "Search Food",
                "operationId": "search_food_search_get",
                "parameters": [
                    {
                        "name": "q",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Q"
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 20,
                            "title": "Limit"
                        }
                    },
                    {
                        "name": "offset",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 0,
                            "title": "Offset"
                        }
                    },
                    {
                        "name": "protein_min",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "number",
                            "default": 0.0,
                            "title": "Protein Min"
                        }
                    },
                    {
                        "name": "calories_max",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "number",
                            "default": 10000.0,
                            "title": "Calories Max"
                        }
                    },
                    {
                        "name": "carbs_max",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "number",
                            "default": 10000.0,
                            "title": "Carbs Max"
                        }
                    },
                    {
                        "name": "sodium_max_mg",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "number",
                            "default": 1000000.0,
                            "title": "Sodium Max Mg"
                        }
                    },
                    {
                        "name": "protein_density_min",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "number",
                            "default": 0.0,
                            "title": "Protein Density Min"
                        }
                    },
                    {
                        "name": "fiber_density_min",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "number",
                            "default": 0.0,
                            "title": "Fiber Density Min"
                        }
                    },
                    {
                        "name": "x-api-key",
                        "in": "header",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "title": "X-Api-Key"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/nutrition": {
            "get": {
                "summary": "Calculate Nutrition",
                "operationId": "calculate_nutrition_nutrition_get",
                "parameters": [
                    {
                        "name": "item_type",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Item Type"
                        }
                    },
                    {
                        "name": "item_id",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "title": "Item Id"
                        }
                    },
                    {
                        "name": "grams",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "number",
                            "title": "Grams"
                        }
                    },
                    {
                        "name": "include_micro",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "boolean",
                            "default": false,
                            "title": "Include Micro"
                        }
                    },
                    {
                        "name": "x-api-key",
                        "in": "header",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "title": "X-Api-Key"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/units": {
            "get": {
                "summary": "Get Food Units",
                "operationId": "get_food_units_units_get",
                "parameters": [
                    {
                        "name": "item_type",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Item Type"
                        }
                    },
                    {
                        "name": "item_id",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "title": "Item Id"
                        }
                    },
                    {
                        "name": "x-api-key",
                        "in": "header",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "title": "X-Api-Key"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/autocomplete": {
            "get": {
                "summary": "Autocomplete Food",
                "operationId": "autocomplete_food_autocomplete_get",
                "parameters": [
                    {
                        "name": "q",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "minLength": 1,
                            "title": "Q"
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 10,
                            "title": "Limit"
                        }
                    },
                    {
                        "name": "x-api-key",
                        "in": "header",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "title": "X-Api-Key"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/meal": {
            "post": {
                "summary": "Calculate Meal Api",
                "operationId": "calculate_meal_api_meal_post",
                "parameters": [
                    {
                        "name": "x-api-key",
                        "in": "header",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "title": "X-Api-Key"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/components/schemas/MealItem"
                                },
                                "title": "Items"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/daily-nutrition": {
            "post": {
                "summary": "Calculate Daily Nutrition",
                "operationId": "calculate_daily_nutrition_daily_nutrition_post",
                "parameters": [
                    {
                        "name": "x-api-key",
                        "in": "header",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "title": "X-Api-Key"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/DailyMeals"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/nutrition/bulk": {
            "post": {
                "summary": "Bulk Nutrition Lookup",
                "operationId": "bulk_nutrition_lookup_nutrition_bulk_post",
                "parameters": [
                    {
                        "name": "x-api-key",
                        "in": "header",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "title": "X-Api-Key"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/components/schemas/MealItem"
                                },
                                "title": "Items"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "DailyMeals": {
                "properties": {
                    "meals": {
                        "items": {
                            "$ref": "#/components/schemas/Meal"
                        },
                        "type": "array",
                        "title": "Meals"
                    }
                },
                "type": "object",
                "required": [
                    "meals"
                ],
                "title": "DailyMeals"
            },
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "Meal": {
                "properties": {
                    "items": {
                        "items": {
                            "$ref": "#/components/schemas/MealItem"
                        },
                        "type": "array",
                        "title": "Items"
                    }
                },
                "type": "object",
                "required": [
                    "items"
                ],
                "title": "Meal"
            },
            "MealItem": {
                "properties": {
                    "item_type": {
                        "type": "string",
                        "title": "Item Type"
                    },
                    "item_id": {
                        "type": "integer",
                        "title": "Item Id"
                    },
                    "grams": {
                        "type": "number",
                        "title": "Grams"
                    }
                },
                "type": "object",
                "required": [
                    "item_type",
                    "item_id",
                    "grams"
                ],
                "title": "MealItem"
            },
            "ValidationError": {
                "properties": {
                    "loc": {
                        "items": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "integer"
                                }
                            ]
                        },
                        "type": "array",
                        "title": "Location"
                    },
                    "msg": {
                        "type": "string",
                        "title": "Message"
                    },
                    "type": {
                        "type": "string",
                        "title": "Error Type"
                    },
                    "input": {
                        "title": "Input"
                    },
                    "ctx": {
                        "type": "object",
                        "title": "Context"
                    }
                },
                "type": "object",
                "required": [
                    "loc",
                    "msg",
                    "type"
                ],
                "title": "ValidationError"
            }
        }
    }
}